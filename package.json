{
  "name": "coreplay-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "coreplay": "tsc -p tsconfig.build.json && node dist/cli.js",
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.14"
  }
}
